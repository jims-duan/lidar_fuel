<launch>
  <!-- ================== 地图参数 ================== -->
  <arg name="map_size_x_"/>            <!-- 地图尺寸x方向 -->
  <arg name="map_size_y_"/>            <!-- 地图尺寸y方向 -->
  <arg name="map_size_z_"/>            <!-- 地图尺寸z方向 -->

  <arg name="box_min_x"/>              <!-- 有效区域包围盒最小x -->
  <arg name="box_min_y"/>              <!-- 有效区域包围盒最小y -->
  <arg name="box_min_z"/>              <!-- 有效区域包围盒最小z -->
  <arg name="box_max_x"/>              <!-- 有效区域包围盒最大x -->
  <arg name="box_max_y"/>              <!-- 有效区域包围盒最大y -->
  <arg name="box_max_z"/>              <!-- 有效区域包围盒最大z -->

  <!-- ================== 传感器topic参数 ================== -->
  <arg name="odometry_topic"/>         <!-- 里程计topic名称 -->
  <arg name="sensor_pose_topic"/>      <!-- 传感器位姿topic名称 -->
  <arg name="depth_topic"/>            <!-- 深度图像topic名称 -->
  <arg name="cloud_topic"/>            <!-- 点云topic名称 -->

  <!-- ================== 相机内参 ================== -->
  <arg name="cx"/>                     <!-- 相机主点x -->
  <arg name="cy"/>                     <!-- 相机主点y -->
  <arg name="fx"/>                     <!-- 相机焦距x -->
  <arg name="fy"/>                     <!-- 相机焦距y -->

  <!-- ================== 运动约束参数 ================== -->
  <arg name="max_vel"/>                <!-- 最大速度 -->
  <arg name="max_acc"/>                <!-- 最大加速度 -->

  <!-- ================== 主节点定义 ================== -->
  <node pkg="exploration_manager" name="exploration_node" type="exploration_node" output="screen">
    <!-- 话题重映射 -->
    <remap from ="/odom_world" to="$(arg odometry_topic)"/>
    <remap from ="/map_ros/pose"   to = "$(arg sensor_pose_topic)"/> 
    <remap from ="/map_ros/depth" to = "$(arg depth_topic)"/>
    <remap from ="/map_ros/cloud" to="$(arg cloud_topic)"/>

    <!-- sdf地图参数配置 -->
    <param name="sdf_map/resolution"      value="0.1" /> 
    <param name="sdf_map/map_size_x"   value="$(arg map_size_x_)" /> 
    <param name="sdf_map/map_size_y"   value="$(arg map_size_y_)" /> 
    <param name="sdf_map/map_size_z"   value="$(arg map_size_z_)" /> 
    <!-- <param name="sdf_map/obstacles_inflation"     value="0.099" />  --> <!-- 膨胀半径（备选参数） -->
    <param name="sdf_map/obstacles_inflation"     value="0.4" />         <!-- 膨胀半径 -->
    <param name="sdf_map/local_bound_inflate"    value="0.5"/>          <!-- 局部边界膨胀量 -->
    <param name="sdf_map/local_map_margin" value="20"/>                 <!-- 局部地图边界 -->
    <param name="sdf_map/ground_height"        value="-1.0"/>           <!-- 地面高度 -->
    <param name="sdf_map/default_dist"        value="0.0"/>             <!-- 默认距离 -->
    <!-- 贝叶斯统计参数 -->
    <param name="sdf_map/p_hit"  value="0.65"/>         
    <param name="sdf_map/p_miss" value="0.35"/>
    <param name="sdf_map/p_min"  value="0.12"/>
    <param name="sdf_map/p_max"  value="0.90"/>
    <param name="sdf_map/p_occ"  value="0.80"/>
    <param name="sdf_map/min_ray_length" value="0.3"/>                 <!-- 最小射线长度 -->
    <param name="sdf_map/max_ray_length" value="4.5"/>                 <!-- 最大射线长度 -->
    <param name="sdf_map/virtual_ceil_height"   value="-10"/>          <!-- 虚拟天花板高度 -->
    <param name="sdf_map/optimistic" value="false" type="bool"/>       <!-- 乐观标志 -->
    <param name="sdf_map/signed_dist" value="false" type="bool"/>      <!-- 符号距离标志 -->
    <param name="sdf_map/box_min_x" value="$(arg box_min_x)" type="double"/> <!-- 有效区域box -->
    <param name="sdf_map/box_min_y" value="$(arg box_min_y)" type="double"/>
    <param name="sdf_map/box_min_z" value="$(arg box_min_z)" type="double"/>
    <param name="sdf_map/box_max_x" value="$(arg box_max_x)" type="double"/>
    <param name="sdf_map/box_max_y" value="$(arg box_max_y)" type="double"/>
    <param name="sdf_map/box_max_z" value="$(arg box_max_z)" type="double"/>

    <!-- 地图相关参数 -->
    <param name="map_ros/cx" value="$(arg cx)"/>
    <param name="map_ros/cy" value="$(arg cy)"/>
    <param name="map_ros/fx" value="$(arg fx)"/>
    <param name="map_ros/fy" value="$(arg fy)"/>
    <param name="map_ros/depth_filter_maxdist"   value="5.0"/>           <!-- 深度最大距离 -->
    <param name="map_ros/depth_filter_mindist"   value="0.2"/>           <!-- 深度最小距离 -->
    <param name="map_ros/depth_filter_margin"    value="2"/>             <!-- 外围宽度 -->
    <param name="map_ros/k_depth_scaling_factor" value="1000.0"/>        <!-- k系数 -->
    <param name="map_ros/skip_pixel" value="2"/>                         <!-- 跳跃像素 -->
    <param name="map_ros/esdf_slice_height" value="0.3"/>                <!-- ESDF显示高度切片 -->
    <param name="map_ros/visualization_truncate_height"   value="10.09"/> <!-- 可视化最大高度 -->
    <param name="map_ros/visualization_truncate_low"   value="-2.0"/>    <!-- 可视化最小高度 -->
    <param name="map_ros/show_occ_time"  value="false"/>                 <!-- 是否显示占用时间 -->
    <param name="map_ros/show_esdf_time" value="false"/>                 <!-- 是否显示esdf耗时 -->
    <param name="map_ros/show_all_map" value="true"/>                    <!-- 是否显示完整地图 -->
    <param name="map_ros/frame_id"      value="world"/>                  <!-- 地图坐标系 -->

    <!-- ====== 有限状态机FSM参数 ===== -->
    <param name="fsm/thresh_replan1" value="0.5" type="double"/>         <!-- 重新规划阈值1 -->
    <param name="fsm/thresh_replan2" value="0.5" type="double"/>         <!-- 重新规划阈值2 -->
    <param name="fsm/thresh_replan3" value="1.5" type="double"/>         <!-- 重新规划阈值3 -->
    <!-- <param name="fsm/thresh_replan1" value="0.00001" type="double"/> --> <!-- 开发用 -->
    <!-- <param name="fsm/thresh_replan2" value="100.0" type="double"/>   -->
    <!-- <param name="fsm/thresh_replan3" value="0.1" type="double"/>    -->
    <param name="fsm/replan_time" value="0.100" type="double"/>          <!-- 重新规划时间阈值 -->

    <!-- ====== 探索管理相关参数 ====== -->
    <param name="exploration/refine_local" value="true" type="bool"/>     <!-- 是否本地精细化 -->
    <param name="exploration/refined_num" value="7" type="int"/>          <!-- 精细化次数 -->
    <param name="exploration/refined_radius" value="5.0" type="double"/>  <!-- 精细化半径 -->
    <param name="exploration/max_decay" value="0.8" type="double"/>       <!-- 最大衰减值 -->
    <param name="exploration/top_view_num" value="15" type="int"/>        <!-- top视角数量 -->
    <param name="exploration/vm" value="$(eval 1.0 * arg('max_vel'))" type="double"/>  <!-- 最大速度 -->
    <param name="exploration/am" value="$(eval 1.0 * arg('max_acc'))" type="double"/>  <!-- 最大加速度 -->
    <param name="exploration/yd" value="$(eval 60 * 3.1415926 / 180.0)" type="double"/>  <!-- 最大偏航速率 -->
    <param name="exploration/ydd" value="$(eval 90 * 3.1415926 / 180.0)" type="double"/> <!-- 最大角加速度 -->
    <param name="exploration/w_dir" value="10.5" type="double"/>           <!-- 权重参数 -->
    <param name="exploration/tsp_dir" value="$(find lkh_tsp_solver)/resource" type="string"/> <!-- TSP路径 -->
    <param name="exploration/relax_time" value="1.0" type="double"/>      <!-- 放松时间 -->

    <!-- ====== 边界frontier相关参数 ====== -->
    <param name="frontier/cluster_min" value="20" type="int"/>                    <!-- 最小聚类点数 -->
    <param name="frontier/cluster_size_xy" value="2.0" type="double"/>             <!-- 聚类xy尺寸 -->
    <param name="frontier/cluster_size_z" value="10.0" type="double"/>             <!-- 聚类z尺寸 -->
    <param name="frontier/min_candidate_dist" value="0.75" type="double"/>         <!-- 候选点最小距离 -->
    <param name="frontier/min_candidate_clearance" value="0.21" type="double"/>    <!-- 候选点最小间隙 -->
    <param name="frontier/candidate_dphi" value="$(eval 15 * 3.1415926 / 180.0)" type="double"/> <!-- 候选点角度步长 -->
    <param name="frontier/candidate_rnum" value="3" type="int"/>                   <!-- 候选半径数量 -->
    <param name="frontier/candidate_rmin" value="1.5" type="double"/>              <!-- 候选最小半径 -->
    <param name="frontier/candidate_rmax" value="2.5" type="double"/>              <!-- 候选最大半径 -->
    <param name="frontier/down_sample" value="3" type="int"/>;                     <!-- 下采样率 -->
    <param name="frontier/min_visib_num" value="15" type="int"/>;                  <!-- 最小可见数目 -->
    <param name="frontier/min_view_finish_fraction" value="0.02" type="double"/>;   <!-- 视点最小完成比例 -->

    <!-- ====== 感知工具集参数 ====== -->
    <param name="perception_utils/top_angle" value="0.56125" type="double"/>;      <!-- 顶部夹角 -->
    <param name="perception_utils/left_angle" value="0.69222" type="double"/>;     <!-- 左边夹角 -->
    <param name="perception_utils/right_angle" value="0.68901" type="double"/>;    <!-- 右边夹角 -->
    <param name="perception_utils/max_dist" value="4.5" type="double"/>;           <!-- 感知最大距离 -->
    <param name="perception_utils/vis_dist" value="1.0" type="double"/>;           <!-- 可见距离 -->

    <!-- ====== 朝向规划器参数 ====== -->
    <param name="heading_planner/yaw_diff" value="$(eval 10 * 3.1415926 / 180.0)" type="double"/>   <!-- yaw角步长 -->
    <param name="heading_planner/half_vert_num" value="5" type="int"/>                              <!-- 垂向采样数 -->
    <param name="heading_planner/lambda1" value="2.0" type="double"/>
    <param name="heading_planner/lambda2" value="1.0" type="double"/>
    <param name="heading_planner/max_yaw_rate" value="$(eval 10 * 3.1415926 / 180.0)" type="double"/> <!-- 最大yaw速率 -->
    <param name="heading_planner/w" value="20000.0" type="double"/>
    <param name="heading_planner/weight_type" value="1" type="double"/>

    <!-- ====== 规划器管理参数 ====== -->
    <!-- <param name="manager/max_vel" value="$(arg max_vel)" type="double"/> --> <!-- (备选)最大速度 -->
    <param name="manager/max_vel" value="$(arg max_vel)" type="double"/>             <!-- 最大速度 -->
    <param name="manager/max_acc" value="$(arg max_acc)" type="double"/>             <!-- 最大加速度 -->
    <param name="manager/max_jerk" value="4.0" type="double"/>                        <!-- 最大jerk -->
    <param name="manager/dynamic_environment" value="0" type="int"/>                <!-- 动态环境标志 -->
    <param name="manager/local_segment_length" value="6.0" type="double"/>          <!-- 局部段长度 -->
    <param name="manager/clearance_threshold" value="0.4" type="double"/>           <!-- 安全距离阈值 -->
    <param name="manager/control_points_distance" value="0.95" type="double"/>      <!-- 控制点间距 -->
    <param name="manager/use_geometric_path" value="true" type="bool"/>             <!-- 是否用几何路径 -->
    <param name="manager/use_kinodynamic_path" value="true" type="bool"/>           <!-- 是否用运动学路径 -->
    <param name="manager/use_topo_path" value="true" type="bool"/>                  <!-- 是否用拓扑路径 -->
    <param name="manager/use_optimization" value="true" type="bool"/>               <!-- 是否用优化 -->
    <param name="manager/use_active_perception" value="true" type="bool"/>          <!-- 是否主动感知 -->
    <param name="manager/min_time" value="false" type="bool"/>                       <!-- 是否使用最小时长优化 -->

    <!-- ====== 运动学路径搜索参数 ====== -->
    <param name="search/max_tau" value="0.8" type="double"/>                <!-- 最大tau -->
    <param name="search/init_max_tau" value="1.0" type="double"/>           <!-- 初始最大tau -->
    <param name="search/max_vel" value="$(arg max_vel)" type="double"/>
    <param name="search/vel_margin" value="0.25" type="double"/>            <!-- 速度裕度 -->
    <param name="search/max_acc" value="$(arg max_acc)" type="double"/>
    <param name="search/w_time" value="10.0" type="double"/>                <!-- 时间权重 -->
    <param name="search/horizon" value="5.0" type="double"/>                <!-- 搜索视界 -->
    <param name="search/lambda_heu" value="10.0" type="double"/>            <!-- 启发权重 -->
    <param name="search/resolution_astar" value="0.025" type="double"/>     <!-- A*分辨率 -->
    <param name="search/time_resolution" value="0.8" type="double"/>        <!-- 时间分辨率 -->
    <param name="search/margin" value="0.4" type="double"/>                 <!-- 安全边距 -->
    <param name="search/allocate_num" value="100000" type="int"/>           <!-- 分配空间数量 -->
    <param name="search/check_num" value="10" type="int"/>                  <!-- 检查节点数量 -->
    <param name="search/optimistic" value="false" type="bool"/>             <!-- 乐观搜索标志 -->

    <!-- ====== astar参数 ====== -->
    <param name="astar/lambda_heu" value="10000.0" type="double"/>
    <param name="astar/resolution_astar" value="0.2" type="double"/>
    <param name="astar/allocate_num" value="1000000" type="int"/>
    <param name="astar/max_search_time" value="0.001" type="double"/>

    <!-- ====== 轨迹优化相关参数 ====== -->
    <param name="optimization/ld_smooth" value="20.0" type="double"/>         <!-- 平滑损失权重 -->
    <param name="optimization/ld_dist" value="10.0" type="double"/>           <!-- 距离损失权重 -->
    <param name="optimization/ld_feasi" value="2000.0" type="double"/>           <!-- 可行性损失权重 -->
    <param name="optimization/ld_start" value="100.0" type="double"/>         <!-- 起点约束权重 -->
    <param name="optimization/ld_end" value="0.5" type="double"/>             <!-- 终点约束权重 -->
    <param name="optimization/ld_guide" value="1.5" type="double"/>           <!-- 引导损失权重 -->
    <param name="optimization/ld_waypt" value="0.3" type="double"/>           <!-- 路径点损失权重 -->
    <param name="optimization/ld_view" value="0.0" type="double"/>            <!-- 视点损失权重 -->
    <param name="optimization/ld_time" value="1000.0" type="double"/>            <!-- 时间损失权重 -->
    <param name="optimization/dist0" value="0.7" type="double"/>              <!-- 距离初值 -->
    <param name="optimization/max_vel" value="$(arg max_vel)" type="double"/>
    <param name="optimization/max_acc" value="$(arg max_acc)" type="double"/>
    <param name="optimization/algorithm1" value="15" type="int"/>             <!-- 优化算法1编号 -->
    <param name="optimization/algorithm2" value="11" type="int"/>             <!-- 优化算法2编号 -->
    <param name="optimization/max_iteration_num1" value="2" type="int"/>      <!-- 优化最大迭代次数1 -->
    <param name="optimization/max_iteration_num2" value="2000" type="int"/>   <!-- 优化最大迭代次数2 -->
    <param name="optimization/max_iteration_num3" value="200" type="int"/>    <!-- 优化最大迭代次数3 -->
    <param name="optimization/max_iteration_num4" value="200" type="int"/>    <!-- 优化最大迭代次数4 -->

    <param name="optimization/max_iteration_time1" value="0.0001" type="double"/>  <!-- 优化最大单次时间1 -->
    <param name="optimization/max_iteration_time2" value="0.005" type="double"/>   <!-- 优化最大单次时间2 -->
    <param name="optimization/max_iteration_time3" value="0.003" type="double"/>   <!-- 优化最大单次时间3 -->
    <param name="optimization/max_iteration_time4" value="0.003" type="double"/>   <!-- 优化最大单次时间4 -->
    <param name="bspline/limit_vel" value="$(arg max_vel)" type="double"/>          <!-- bspline最大速度 -->
    <param name="bspline/limit_acc" value="$(arg max_acc)" type="double"/>          <!-- bspline最大加速度 -->
    <param name="bspline/limit_ratio" value="1.1" type="double"/>                  <!-- bspline速度因子 -->
    <param name="bspline/limit_vel" value="$(arg max_vel)" type="double"/>
    <param name="bspline/limit_acc" value="$(arg max_acc)" type="double"/>
    <param name="bspline/limit_ratio" value="1.1" type="double"/>

  </node>

</launch>